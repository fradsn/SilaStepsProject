<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    tools:context="CurrentActivityFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- ===================== HEADER ===================== -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activity Monitor"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-time recognition"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            android:layout_marginTop="2dp" />

        <!-- Status pill: Listening / Offline -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="24dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============= MAIN ACTIVITY CARD ============= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCurrentActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardElevation="12dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="28dp">

                <!-- Pulse rings (animated via code) -->
                <View
                    android:id="@+id/pulseRing3"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0.08"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvActivityLabel"
                    android:layout_marginBottom="20dp" />

                <View
                    android:id="@+id/pulseRing2"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0.15"
                    app:layout_constraintTop_toTopOf="@id/pulseRing3"
                    app:layout_constraintBottom_toBottomOf="@id/pulseRing3"
                    app:layout_constraintStart_toStartOf="@id/pulseRing3"
                    app:layout_constraintEnd_toEndOf="@id/pulseRing3" />

                <View
                    android:id="@+id/pulseRing1"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_pulse_ring_filled"
                    app:layout_constraintTop_toTopOf="@id/pulseRing2"
                    app:layout_constraintBottom_toBottomOf="@id/pulseRing2"
                    app:layout_constraintStart_toStartOf="@id/pulseRing2"
                    app:layout_constraintEnd_toEndOf="@id/pulseRing2" />

                <!-- Activity Icon -->
                <ImageView
                    android:id="@+id/ivActivityIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_activity_walking"
                    app:layout_constraintTop_toTopOf="@id/pulseRing1"
                    app:layout_constraintBottom_toBottomOf="@id/pulseRing1"
                    app:layout_constraintStart_toStartOf="@id/pulseRing1"
                    app:layout_constraintEnd_toEndOf="@id/pulseRing1"
                    app:tint="@color/white" />

                <!-- Activity Name -->
                <TextView
                    android:id="@+id/tvActivityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walking"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:layout_constraintTop_toBottomOf="@id/pulseRing3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="20dp" />

                <!-- Confidence bar label -->
                <TextView
                    android:id="@+id/tvConfidenceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confidence"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tvActivityLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/tvConfidenceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="87%"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/tvConfidenceLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Confidence ProgressBar -->
                <ProgressBar
                    android:id="@+id/progressConfidence"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="87"
                    android:progressDrawable="@drawable/progress_confidence"
                    app:layout_constraintTop_toBottomOf="@id/tvConfidenceLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============= STATS ROW ============= -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/cardCurrentActivity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Stat: Duration -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4m 12s"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stat: Steps -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👟"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="342"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Steps"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stat: Calories -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kcal"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ============= HEART RATE BLE CARD ============= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeartRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardElevation="8dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/statsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <!-- Titolo card -->
                <TextView
                    android:id="@+id/tvHeartRateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battito Cardiaco"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Dot stato BLE -->
                <View
                    android:id="@+id/dotBleStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/text_muted"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintTop_toTopOf="@id/tvBleStatusLabel"
                    app:layout_constraintBottom_toBottomOf="@id/tvBleStatusLabel"
                    app:layout_constraintEnd_toStartOf="@id/tvBleStatusLabel" />

                <!-- Stato connessione -->
                <TextView
                    android:id="@+id/tvBleStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Non connesso"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/tvHeartRateTitle"
                    app:layout_constraintBottom_toBottomOf="@id/tvHeartRateTitle"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Divider -->
                <View
                    android:id="@+id/dividerHr"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/card_surface_alt"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/tvHeartRateTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Cuore (emoji, nessun drawable necessario) -->
                <TextView
                    android:id="@+id/ivHeartIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️"
                    android:textSize="28sp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/dividerHr"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Valore BPM -->
                <TextView
                    android:id="@+id/tvBpmValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/white"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light"
                    app:layout_constraintTop_toTopOf="@id/ivHeartIcon"
                    app:layout_constraintBottom_toBottomOf="@id/ivHeartIcon"
                    app:layout_constraintStart_toEndOf="@id/ivHeartIcon"
                    android:layout_marginStart="14dp" />

                <TextView
                    android:id="@+id/tvBpmUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BPM"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvBpmValue"
                    app:layout_constraintStart_toEndOf="@id/tvBpmValue"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp" />

                <!-- Range normale -->
                <TextView
                    android:id="@+id/tvBpmRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Range normale: 60 – 100 bpm"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@id/ivHeartIcon"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Ultima lettura -->
                <TextView
                    android:id="@+id/tvLastReading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/tvBpmRange"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnConnectRing"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Pulsante connetti/disconnetti -->
                <Button
                    android:id="@+id/btnConnectRing"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Connetti Ring"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/accent_teal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    app:cornerRadius="19dp"
                    app:layout_constraintTop_toBottomOf="@id/tvBpmRange"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============= ML STATUS BANNER ============= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMlStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_surface_alt"
            app:cardElevation="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardHeartRate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cloud_ml"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/accent_teal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ML Model"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMlStatusDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cloud inference — not yet connected"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Badge -->
                <TextView
                    android:id="@+id/tvMlBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEMO"
                    android:background="@drawable/bg_badge_demo"
                    android:textColor="@color/accent_orange"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>