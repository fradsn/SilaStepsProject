<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    tools:context=".UI.CurrentActivityFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activity Monitor"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCurrentActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/card_surface"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp">
                <View android:id="@+id/pulseRing3" android:layout_width="160dp" android:layout_height="160dp" android:background="@drawable/bg_pulse_ring" android:alpha="0.08" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
                <View android:id="@+id/pulseRing2" android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/bg_pulse_ring" android:alpha="0.15" app:layout_constraintTop_toTopOf="@id/pulseRing3" app:layout_constraintBottom_toBottomOf="@id/pulseRing3" app:layout_constraintStart_toStartOf="@id/pulseRing3" app:layout_constraintEnd_toEndOf="@id/pulseRing3" />
                <View android:id="@+id/pulseRing1" android:layout_width="84dp" android:layout_height="84dp" android:background="@drawable/bg_pulse_ring_filled" app:layout_constraintTop_toTopOf="@id/pulseRing2" app:layout_constraintBottom_toBottomOf="@id/pulseRing2" app:layout_constraintStart_toStartOf="@id/pulseRing2" app:layout_constraintEnd_toEndOf="@id/pulseRing2" />
                <ImageView android:id="@+id/ivActivityIcon" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_activity_walking" app:layout_constraintTop_toTopOf="@id/pulseRing1" app:layout_constraintBottom_toBottomOf="@id/pulseRing1" app:layout_constraintStart_toStartOf="@id/pulseRing1" app:layout_constraintEnd_toEndOf="@id/pulseRing1" app:tint="@color/white" />
                <TextView android:id="@+id/tvActivityLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Walking" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@id/pulseRing3" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
                <ProgressBar android:id="@+id/progressConfidence" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="87" android:progressDrawable="@drawable/progress_confidence" app:layout_constraintTop_toBottomOf="@id/tvActivityLabel" android:layout_marginTop="24dp" />
                <TextView android:id="@+id/tvConfidenceValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="87%" android:textColor="@color/accent_teal" android:textSize="12sp" app:layout_constraintBottom_toTopOf="@id/progressConfidence" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="4dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeartRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/card_surface"
            app:layout_constraintTop_toBottomOf="@id/cardCurrentActivity">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                <TextView android:id="@+id/tvHeartRateTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Battito Cardiaco" android:textColor="@color/white" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

                <TextView android:id="@+id/tvBpmValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/white" android:textSize="42sp" android:textStyle="bold" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/tvHeartRateTitle" app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/tvBpmValue">
                    <Button android:id="@+id/btnToggleHR" android:layout_width="match_parent" android:layout_height="40dp" android:text="START BPM" android:backgroundTint="@color/accent_teal" android:textSize="10sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardOxygen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/card_surface"
            app:layout_constraintTop_toBottomOf="@id/cardHeartRate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cardBP">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ossigeno" android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:id="@+id/tvSpO2Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="@color/accent_teal" android:textSize="22sp" android:textStyle="bold" />
                <Button android:id="@+id/btnStartSpO2" android:layout_width="match_parent" android:layout_height="40dp" android:text="AVVIA SPO₂" android:backgroundTint="@color/accent_teal" android:textSize="10sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardBP"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/card_surface"
            app:layout_constraintTop_toTopOf="@id/cardOxygen"
            app:layout_constraintStart_toEndOf="@id/cardOxygen"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pressione" android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:id="@+id/tvBpValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- / --" android:textColor="@color/accent_orange" android:textSize="22sp" android:textStyle="bold" />
                <Button android:id="@+id/btnStartBP" android:layout_width="match_parent" android:layout_height="40dp" android:text="AVVIA BP" android:backgroundTint="@color/accent_teal" android:textSize="10sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>